# Publish only reviewed source files and the public screenshot; exclude local data.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/README.zh-CN.md
!/INSTALL.zh-CN.md
!/LICENSE
!/NOTICE
!/adapter.js
!/cdp.mjs
!/data.mjs
!/focus.mjs
!/host.mjs
!/launch.ps1
!/launch-core.ps1
!/start.vbs
!/start-menu-shortcut.ps1
!/start-link.cs
!/stop.ps1
!/stop.vbs
!/install.ps1
!/install.cmd
!/package-portable.py
!/assets/
/assets/*
!/assets/statusline.png
!/vendor/
/vendor/*
!/vendor/statusline.js
!/test/
/test/*
!/test/usage.test.mjs
!/test/launch.test.ps1
!/test/renderer.test.mjs
